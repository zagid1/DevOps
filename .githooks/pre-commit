#!/bin/bash
# Pre-commit hook: проверяет staged Python файлы на TODO-комментарии.
#
# Проверяется staged-контент (git diff --cached), а не working tree:
# в коммит попадает только то, что проиндексировано.

echo "🔍 Pre-commit: проверка staged files..."

# Staged файлы: добавленные, изменённые, переименованные, только Python
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Нет staged Python файлов, пропускаем проверку"
    exit 0
fi

# Каждый файл проверяем отдельно, чтобы точно указать, где найдено TODO
FAILED=0
for file in $STAGED_FILES; do
    # -U0 — без контекста, ловим только добавленные строки (^+)
    if git diff --cached --unified=0 --no-color -- "$file" | grep -q '^+.*TODO'; then
        echo "❌ Найден TODO-комментарий: $file"
        FAILED=1
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "Удалите TODO или закоммитьте с --no-verify (но CI всё равно проверит)"
    exit 1
fi

echo "✅ Pre-commit checks passed"
exit 0
