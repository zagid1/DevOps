#!/bin/bash
# Pre-commit hook: проверяет staged Python файлы на TODO-комментарии.
#
# ВАЖНО: проверяется staged-контент (git diff --cached), а не working tree,
# потому что в коммит попадает только то, что проиндексировано.

echo "🔍 Pre-commit: проверка staged files..."

# Список staged файлов, которые добавляются/изменяются/переименовываются
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Нет staged Python файлов, пропускаем проверку"
    exit 0
fi

# Проверяем каждый файл отдельно, чтобы точно знать, где именно TODO
FAILED=0
for file in $STAGED_FILES; do
    # -U0 — без контекста, чтобы поймать только добавленные строки (^+)
    if git diff --cached --unified=0 --no-color -- "$file" | grep -q '^+.*TODO'; then
        echo "❌ Найден TODO-комментарий: $file"
        FAILED=1
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "Удалите TODO или закоммитьте с --no-verify (но CI всё равно проверит)"
    exit 1
fi

echo "✅ Pre-commit checks passed"
exit 0
