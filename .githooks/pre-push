#!/bin/bash
# Pre-push: быстрые проверки + юнит-тесты.
#
# Философия задания: локальный хук даёт быструю обратную связь и может быть
# обойдён (--no-verify). Единственный источник истины — Jenkins, поэтому
# отсутствие pytest здесь НЕ блокирует push, а лишь предупреждает.
set -uo pipefail

echo "🔍 Pre-push: fast checks + unit tests..."

if ! bash scripts/checks.sh; then
    echo "❌ pre-push blocked: fast checks failed"
    exit 1
fi

. scripts/_common.sh

# Ищем интерпретатор, в котором установлен pytest, а не первый в PATH.
if PY="$(pick_python pytest)"; then
    echo "→ running unit tests via: $PY"
    if ! "$PY" -m pytest tests/ -q --tb=short; then
        echo "❌ pre-push blocked: unit tests failed"
        exit 1
    fi
    echo "✅ Unit tests passed"
else
    echo "⚠️  pytest unavailable locally — skipping unit tests."
    echo "   Это не блокирует push: Jenkins прогнит их на сервере."
fi

echo "✅ Pre-push passed"
exit 0